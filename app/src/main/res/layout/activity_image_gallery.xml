<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 垂直长画布 RecyclerView（V4 重构：替换原 ViewPager2 双层嵌套） -->
    <!-- BUG1 fix: clipToPadding=false + paddingTop 允许内容在 padding 区域绘制，第一张图不被 TitleBar 遮挡 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 全屏横向浏览 ViewPager2 层（AD-05：初始 gone，点击图片时显示并定位） -->
    <!-- z-order：覆盖 RecyclerView，位于 TitleBar 之下（TitleBar/页码/旋转工具栏保持可见） -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 隐藏 WebView（1x1 像素）：用于预热图片 CDN 域名，获取 Cloudflare 验证 cookies -->
    <!-- 方案A：ImageGalleryActivity 启动时加载图片 CDN 域名，WebView 自动处理 JS 挑战 -->
    <!-- CookieStore 会自动保存 cookies，Glide 后续请求复用 cookies 解决防盗链 -->
    <WebView
        android:id="@+id/webview_preheat"
        android:layout_width="1px"
        android:layout_height="1px"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 顶部顶栏（L-C15 S5 改造）：Compose GlassTopAppBar -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 页码显示（"当前 / 总数"，单图时隐藏） -->
    <TextView
        android:id="@+id/tv_page_index"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_image_page_index"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 加载进度 -->
    <ProgressBar
        android:id="@+id/progress_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 错误提示 + 重试按钮 -->
    <LinearLayout
        android:id="@+id/layout_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxWidth="280dp"
            android:maxLines="3"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_16sp"
            tools:text="加载失败" />

        <Button
            android:id="@+id/btn_retry"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="重试"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- 底部旋转工具栏（点击切换显隐，与沉浸式联动） -->
    <LinearLayout
        android:id="@+id/layout_rotate_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_rotate_toolbar"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btn_rotate_left"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="逆时针旋转90度"
            android:src="@drawable/ic_rotate_left"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btn_reset"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="重置视图"
            android:src="@drawable/ic_reset"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btn_rotate_right"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="顺时针旋转90度"
            android:src="@drawable/ic_rotate_right"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- 垂直画布模式页码悬浮（右下角，显示当前文章图片索引/总数） -->
    <TextView
        android:id="@+id/tv_canvas_page_index"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_image_page_index"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

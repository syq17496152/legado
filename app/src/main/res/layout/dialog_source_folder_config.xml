<?xml version="1.0" encoding="utf-8"?>
<!-- source-layout-deep-refactor 书源/订阅源布局配置对话框（参考 dialog_bookshelf_config.xml） -->
<!-- 修复：RadioButton 必须有 android:id，否则 getCheckedIndex() 依赖 getId() 会总返回 0 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- 1. 分组样式：列表 / 按类型 / 按分组 -->
        <LinearLayout
            android:id="@+id/ll_group_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="6dp"
                android:text="@string/group_style"
                android:textColor="@color/primaryText" />

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/sp_group_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:entries="@array/source_group_style_new"
                android:theme="@style/Spinner"
                tools:ignore="TouchTargetSizeCheck" />

        </LinearLayout>

        <!-- D1: 展示模式（标签/分组），仅 sourceGroupStyle!=0 时生效 -->
        <LinearLayout
            android:id="@+id/ll_group_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/ll_group_style">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="6dp"
                android:text="@string/source_group_mode"
                android:textColor="@color/primaryText" />

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/sp_group_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:entries="@array/source_group_mode_items"
                android:theme="@style/Spinner"
                tools:ignore="TouchTargetSizeCheck" />

        </LinearLayout>

        <!-- 2. 视图模式 + 3. 排序（左右两列布局，参考书架） -->
        <LinearLayout
            android:id="@+id/ll_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/ll_sort"
            app:layout_constraintTop_toBottomOf="@+id/ll_group_mode">

            <io.legado.app.ui.widget.text.AccentTextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:text="@string/source_layout"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/rg_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_source_layout_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/layout_list"
                    tools:ignore="TouchTargetSizeCheck" />

                <RadioButton
                    android:id="@+id/rb_source_layout_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/layout_list_compact"
                    tools:ignore="TouchTargetSizeCheck" />

                <RadioButton
                    android:id="@+id/rb_source_layout_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/layout_grid2"
                    tools:ignore="TouchTargetSizeCheck" />

                <RadioButton
                    android:id="@+id/rb_source_layout_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/layout_grid3"
                    tools:ignore="TouchTargetSizeCheck" />

                <RadioButton
                    android:id="@+id/rb_source_layout_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/layout_grid4"
                    tools:ignore="TouchTargetSizeCheck" />

                <RadioButton
                    android:id="@+id/rb_source_layout_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/layout_grid5"
                    tools:ignore="TouchTargetSizeCheck" />

                <RadioButton
                    android:id="@+id/rb_source_layout_6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/layout_grid6"
                    tools:ignore="TouchTargetSizeCheck" />
            </RadioGroup>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_sort"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintLeft_toRightOf="@+id/ll_layout"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_group_mode">

            <io.legado.app.ui.widget.text.AccentTextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:text="@string/source_sort_label"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/rg_sort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_source_sort_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/source_sort_0"
                    tools:ignore="TouchTargetSizeCheck" />

                <RadioButton
                    android:id="@+id/rb_source_sort_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/source_sort_1"
                    tools:ignore="TouchTargetSizeCheck" />

                <RadioButton
                    android:id="@+id/rb_source_sort_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/source_sort_2"
                    tools:ignore="TouchTargetSizeCheck" />

                <RadioButton
                    android:id="@+id/rb_source_sort_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/source_sort_3"
                    tools:ignore="TouchTargetSizeCheck" />

                <RadioButton
                    android:id="@+id/rb_source_sort_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/source_sort_4"
                    tools:ignore="TouchTargetSizeCheck" />

                <RadioButton
                    android:id="@+id/rb_source_sort_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/source_sort_5"
                    tools:ignore="TouchTargetSizeCheck" />

            </RadioGroup>

        </LinearLayout>

        <!-- 4. 间距 -->
        <io.legado.app.ui.widget.DetailSeekBar
            android:id="@+id/sb_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_layout"
            app:max="60"
            app:title="@string/margin" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

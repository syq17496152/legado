<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <io.legado.app.ui.widget.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:contentInsetStartWithNavigation="0dp"
        app:displayHomeAsUp="true"
        app:title="@string/auto_task_edit" />

    <io.legado.app.ui.widget.NoChildScrollNestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <io.legado.app.lib.theme.view.ThemeCheckBox
                    android:id="@+id/cb_enable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/is_enable"
                    tools:ignore="TouchTargetSizeCheck" />

                <io.legado.app.lib.theme.view.ThemeCheckBox
                    android:id="@+id/cb_cookie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:checked="true"
                    android:text="@string/auto_task_cookie_jar"
                    tools:ignore="RtlHardcoded,TouchTargetSizeCheck" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <io.legado.app.ui.widget.text.TextInputLayout
                android:id="@+id/til_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/name">

                <io.legado.app.lib.theme.view.ThemeEditText
                    android:id="@+id/et_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />
            </io.legado.app.ui.widget.text.TextInputLayout>

            <io.legado.app.ui.widget.text.TextInputLayout
                android:id="@+id/til_cron"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/auto_task_cron">

                <io.legado.app.lib.theme.view.ThemeEditText
                    android:id="@+id/et_cron"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />
            </io.legado.app.ui.widget.text.TextInputLayout>

            <io.legado.app.ui.widget.text.TextInputLayout
                android:id="@+id/til_comment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/auto_task_comment">

                <io.legado.app.lib.theme.view.ThemeEditText
                    android:id="@+id/et_comment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />
            </io.legado.app.ui.widget.text.TextInputLayout>

            <io.legado.app.ui.widget.text.TextInputLayout
                android:id="@+id/til_script"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/auto_task_script">

                <io.legado.app.lib.theme.view.ThemeEditText
                    android:id="@+id/et_script"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:minLines="4"
                    tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />
            </io.legado.app.ui.widget.text.TextInputLayout>

            <io.legado.app.ui.widget.text.TextInputLayout
                android:id="@+id/til_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/auto_task_header">

                <io.legado.app.lib.theme.view.ThemeEditText
                    android:id="@+id/et_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />
            </io.legado.app.ui.widget.text.TextInputLayout>

            <io.legado.app.ui.widget.text.TextInputLayout
                android:id="@+id/til_jslib"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/auto_task_jslib">

                <io.legado.app.lib.theme.view.ThemeEditText
                    android:id="@+id/et_jslib"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />
            </io.legado.app.ui.widget.text.TextInputLayout>

            <io.legado.app.ui.widget.text.TextInputLayout
                android:id="@+id/til_concurrent_rate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/auto_task_concurrent_rate">

                <io.legado.app.lib.theme.view.ThemeEditText
                    android:id="@+id/et_concurrent_rate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />
            </io.legado.app.ui.widget.text.TextInputLayout>

            <io.legado.app.ui.widget.text.TextInputLayout
                android:id="@+id/til_login_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/login_url">

                <io.legado.app.lib.theme.view.ThemeEditText
                    android:id="@+id/et_login_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />
            </io.legado.app.ui.widget.text.TextInputLayout>

            <io.legado.app.ui.widget.text.TextInputLayout
                android:id="@+id/til_login_ui"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/login_ui">

                <io.legado.app.lib.theme.view.ThemeEditText
                    android:id="@+id/et_login_ui"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />
            </io.legado.app.ui.widget.text.TextInputLayout>

            <io.legado.app.ui.widget.text.TextInputLayout
                android:id="@+id/til_login_check_js"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/login_check_js">

                <io.legado.app.lib.theme.view.ThemeEditText
                    android:id="@+id/et_login_check_js"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />
            </io.legado.app.ui.widget.text.TextInputLayout>

        </LinearLayout>
    </io.legado.app.ui.widget.NoChildScrollNestedScrollView>

</LinearLayout>

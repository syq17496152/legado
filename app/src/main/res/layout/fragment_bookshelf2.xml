<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 书架页顶栏对齐 Archive MainTopBarView（跟随昼夜主题） -->
    <io.legado.app.ui.widget.MainTopBarView
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 书架刷新单层化（spinner-fix delta 2026-09-05）：外层 SwipeRefreshLayout 已删除——
         它无 listener 无复位代码，下拉手势显示的转圈永久常驻（用户实锤"两个转圈一个不消失"）；
         下拉刷新由内层 Compose SwipeRefreshContainer 承担（触发即收圈） -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/rv_bookshelf"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tv_empty_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="16dp"
        android:gravity="center"
        android:text="@string/bookshelf_empty"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:text="TextView" />

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<!-- video-player-dual-layout AD-10：根布局改垂直 LinearLayout，composeTopBar 提升到根（两布局共用），
     内容区 FrameLayout 承载双容器（沉浸式 viewPagerContainer / 传统 legacyContainer），由 layoutMode 分发显隐 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Compose 顶栏（L-D9 S5 改造）：GlassTopAppBar，全屏时 gone/visible 控制显隐 -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:id="@+id/layout_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- R3 抖音风格：ViewPager2 容器（垂直滑动切换视频） -->
        <LinearLayout
            android:id="@+id/viewPagerContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

        <!-- 传统布局（video-player-dual-layout：上播放器 + 下部信息区） -->
        <LinearLayout
            android:id="@+id/legacyContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <io.legado.app.help.gsyVideo.VideoPlayer
                android:id="@+id/playerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:layout_height="300dp" />

            <LinearLayout
                android:id="@+id/data"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <io.legado.app.ui.widget.image.CoverImageView
                    android:id="@+id/iv_cover"
                    android:layout_width="104dp"
                    android:layout_height="148dp"
                    android:contentDescription="@string/img_cover"
                    android:scaleType="centerCrop"
                    android:src="@drawable/image_cover_default" />

                <LinearLayout
                    android:id="@+id/info"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:text="@string/book_name"
                        android:textColor="@color/primaryText"
                        android:textSize="@dimen/text_18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_author"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/author"
                            android:textColor="@color/tv_text_summary"
                            android:textSize="@dimen/text_12sp" />

                        <!-- video-player-dual-layout K6：跨影片「下一部」入口（书源列表队列，耗尽时隐藏） -->
                        <TextView
                            android:id="@+id/tv_next_film"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:contentDescription="@string/play_next_film"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="4dp"
                            android:paddingBottom="4dp"
                            android:singleLine="true"
                            android:text="@string/play_next_film"
                            android:textColor="@color/primaryText"
                            android:textSize="@dimen/text_12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/scroll_view_r"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:scrollbars="none">
                        <FrameLayout
                            android:id="@+id/tv_intro_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </androidx.core.widget.NestedScrollView>

                </LinearLayout>

            </LinearLayout>

            <!-- video-player-dual-layout W2-B2：传统布局功能按钮区（对齐沉浸式核心能力：下载/收藏/悬浮窗/设置） -->
            <LinearLayout
                android:id="@+id/legacy_actions"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/action_download"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/action_download"
                        android:src="@drawable/ic_download"
                        app:tint="@color/primaryText" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/action_download"
                        android:textColor="@color/tv_text_summary"
                        android:textSize="@dimen/text_11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/action_star"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_action_star"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/favorite"
                        android:src="@drawable/ic_star_border"
                        app:tint="@color/primaryText" />

                    <TextView
                        android:id="@+id/tv_action_star"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/favorite"
                        android:textColor="@color/tv_text_summary"
                        android:textSize="@dimen/text_11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/action_float"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/float_window"
                        android:src="@drawable/ic_screen"
                        app:tint="@color/primaryText" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/float_window"
                        android:textColor="@color/tv_text_summary"
                        android:textSize="@dimen/text_11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/action_settings"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/setting"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/primaryText" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/setting"
                        android:textColor="@color/tv_text_summary"
                        android:textSize="@dimen/text_11sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/chapters_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="vertical">

                <!-- W2-B3：区块标题平铺（去掉 iv_chapter 二级目录页入口，线路/选集直接页内呈现） -->
                <TextView
                    android:id="@+id/tv_route_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="2dp"
                    android:text="@string/video_section_routes"
                    android:textColor="@color/primaryText"
                    android:textSize="@dimen/text_14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/volumes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="2dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <TextView
                    android:id="@+id/tv_episode_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="2dp"
                    android:text="@string/video_section_episodes"
                    android:textColor="@color/primaryText"
                    android:textSize="@dimen/text_14sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/chapters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            </LinearLayout>

        </LinearLayout><!-- legacyContainer end -->

    </FrameLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    R3 抖音风格沉浸式竖屏视频播放器 Fragment
    设计文档 1.4 节布局规范 + ADR-8 多线路 UI 布局：
    - 根布局 ConstraintLayout
    - 播放器铺满 + 悬浮控件层叠加
    - 左下角垂直：标题 → 线路选择器 → 集数选择器（横向滚动）→ 全屏按钮（居中）
    - 右侧竖直：快退/静音/收藏/倍速/设置/快进
    样式：48dp按钮 / 16dp间距 / #80000000半透明黑12dp圆角 / 14sp白色标题
    用户需求：所有功能按钮图标统一白色（android:tint="#FFFFFF"）
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 播放器视图（铺满屏幕） -->
    <io.legado.app.help.gsyVideo.VideoPlayer
        android:id="@+id/playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- P0-1.6: WebView 降级播放器（ExoPlayer 失败时使用，复用 skill V2 hls-video-player 模板） -->
    <io.legado.app.ui.video.WebViewVideoPlayer
        android:id="@+id/webViewPlayer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- P0-1.6: 切换回内置播放器按钮（WebView 模式下显示，独立于 controlsLayer） -->
    <ImageButton
        android:id="@+id/btn_switch_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_overlay_button"
        android:contentDescription="@string/switch_to_exo_player"
        android:src="@drawable/ic_swap_horiz"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:tint="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 悬浮控件层（clickable=false，不拦截触摸事件） -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controlsLayer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- B1+ 修复：全屏模式下的悬浮返回按钮
             根因：F1 真全屏修复中 titleBarNew.gone() 隐藏了整个 TitleBar 包括返回按钮，
             导致全屏模式下返回按钮不可见、不可点击（日志证据：全屏9秒内无VideoBack日志触发）。
             修复：添加独立的悬浮返回按钮，全屏时显示，参与 overlay controls 3秒自动隐藏。
             非全屏时隐藏（由 titleBarNew 提供返回按钮）。 -->
        <ImageButton
            android:id="@+id/btn_back_overlay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_overlay_button"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:tint="#FFFFFF"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 左下角区域：标题 + 线路选择器 + 集数选择器 + 全屏按钮
             占满宽度减去右侧按钮区域，内容左对齐，全屏按钮水平居中 -->
        <LinearLayout
            android:id="@+id/left_bottom_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="56dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/right_buttons">

            <!-- 视频标题（14sp 白色 #80000000背景 12dp圆角 padding 12dp） -->
            <TextView
                android:id="@+id/tv_video_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_overlay_button"
                android:padding="12dp" />

            <!-- 线路选择器（多线路时显示，点击弹出线路列表） -->
            <TextView
                android:id="@+id/tv_route_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_12sp"
                android:background="@drawable/bg_overlay_button"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:visibility="gone" />

            <!-- 集数选择器（横向滚动，多集时显示） -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_episodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:overScrollMode="never"
                android:visibility="gone" />

        </LinearLayout>

        <!-- 右侧竖直功能按钮容器（48dp按钮 / 16dp间距）
             U1 优化：全屏按钮移入此容器作为第一个按钮，随整体3秒自动隐藏+单击重新显示
             用户需求：所有按钮图标统一白色（android:tint="#FFFFFF"） -->
        <LinearLayout
            android:id="@+id/right_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 全屏按钮（U1：从视频中下方迁移到右侧功能区，随整体显隐；
                 bug①修复：默认 visible，由 updateFullscreenButtonVisibility 保持显示；随 right_buttons 3秒自动隐藏+单击显示） -->
            <ImageButton
                android:id="@+id/btn_fullscreen"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_overlay_button"
                android:contentDescription="@string/full_screen"
                android:src="@drawable/ic_fullscreen"
                android:scaleType="centerInside"
                android:padding="12dp"
                android:tint="#FFFFFF" />

            <!-- video-gesture-overhaul: 快退按钮已移除，改为左右滑动 seek（R2/R3） -->

            <!-- 收藏按钮 -->
            <ImageButton
                android:id="@+id/btn_star"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_overlay_button"
                android:contentDescription="@string/favorite"
                android:src="@drawable/ic_star_border"
                android:scaleType="centerInside"
                android:padding="12dp"
                android:tint="#FFFFFF" />

            <!-- 设置按钮 -->
            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_overlay_button"
                android:contentDescription="@string/setting"
                android:src="@drawable/ic_settings"
                android:scaleType="centerInside"
                android:padding="12dp"
                android:tint="#FFFFFF" />

            <!-- video-gesture-overhaul: 快进按钮已移除，改为左右滑动 seek（R2/R3） -->

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- 文件夹视图卡片（样式完全对齐书架分组卡片 FolderGroupGridContent：7:10 封面 + 8dp 圆角 + 默认 FolderOpen 图标 + 分组名在封面下方跟随主题，showBookname 控制显隐） -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cv_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_item_focused_on_tv"
    android:clickable="true"
    android:focusable="true"
    android:scrollbars="none"
    tools:ignore="UnusedAttribute">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingTop="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="4dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <!-- 文件夹封面区域：比例/圆角/默认图标样式完全对齐书架分组卡片（FolderGroupGridContent：
                 7:10 比例 + 8dp 圆角；底色/图标 tint 由 SourceFolderAdapter 运行时注入——
                 页面主题为 AppCompat（非 Material3），此处不可用 ?attr/colorSurfaceContainerHigh 等 M3 属性，否则运行时 InflateException） -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_folder_cover"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="4dp"
                android:contentDescription="@string/folder_view"
                android:scaleType="centerCrop"
                android:transitionName="img_cover"
                app:layout_constraintDimensionRatio="0.7"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.SourceFolderCover"
                tools:ignore="ImageContrastCheck,UnusedAttribute" />

            <!-- 分组默认图标（无自定义封面时显示，tint 由 SourceFolderAdapter 运行时注入主题文字次色） -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_folder_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_folder_open"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/iv_folder_cover"
                app:layout_constraintEnd_toEndOf="@id/iv_folder_cover"
                app:layout_constraintStart_toStartOf="@id/iv_folder_cover"
                app:layout_constraintTop_toTopOf="@id/iv_folder_cover" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 分组名（封面下方，对齐书架 grid_group：12sp 主题文本色，2 行居中；showBookname 控制显隐） -->
        <TextView
            android:id="@+id/tv_folder_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="top|center_horizontal"
            android:includeFontPadding="false"
            android:lines="2"
            android:textColor="@color/primaryText"
            android:textSize="@dimen/text_12sp"
            tools:ignore="RtlHardcoded,RtlSymmetry"
            tools:text="默认分组" />

    </LinearLayout>

    <View
        android:id="@+id/vw_foreground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?android:attr/selectableItemBackground"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        tools:layout_editor_absoluteX="0dp" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    图片垂直画布 - 图片项布局（item_image_canvas）
    - 宽度填满，高度动态调整（默认 60% 屏幕高，加载完成后按宽高比调整）
    - PhotoView 支持缩放/旋转/平移（PhotoView 自带能力）
    - 加载失败时显示错误图标 + 重试按钮（点击触发降级链）
    - 降级链触发时显示"正在尝试备用方案 N/4..."提示（V4 6.1.5）
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/black">

    <io.legado.app.ui.widget.image.PhotoView
        android:id="@+id/photo_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <!-- 长图金字塔视图（Phase 3.2 AD-06：默认隐藏，检测到长图时替换 PhotoView 显示） -->
    <!-- BitmapRegionDecoder 按需解码可视区域瓦片，内存占用与图片尺寸无关，长图防 OOM -->
    <com.davemorrissey.labs.subscaleview.SubsamplingScaleImageView
        android:id="@+id/ssiv_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 降级链级别提示（V4 6.1.5：默认隐藏，降级链触发时显示） -->
    <TextView
        android:id="@+id/tv_fallback_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#80000000"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/text_11sp"
        android:visibility="gone" />

    <!-- W7 8.3 逐项占位（REQ-29）：加载/降级期间显示，消除静默黑屏；成功或终态失败即隐藏 -->
    <ProgressBar
        android:id="@+id/pb_item_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/white"
        android:visibility="gone" />

    <!-- W7 8.3 逐项失败（REQ-29）：原因（分类文案，与 footer 同口径）+ 原地重试 -->
    <LinearLayout
        android:id="@+id/layout_item_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_item_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxWidth="280dp"
            android:maxLines="3"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_14sp" />

        <Button
            android:id="@+id/btn_item_retry"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/retry"
            android:textColor="@android:color/white" />

    </LinearLayout>

</FrameLayout>

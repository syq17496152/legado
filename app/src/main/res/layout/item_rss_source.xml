<?xml version="1.0" encoding="utf-8"?>
<!-- Issue-6 重构：参考书架列表 item_bookshelf_list.xml 布局结构 + item_book_source.xml 字段映射 -->
<!-- ADR-13: 订阅源列表差异：无 iv_explore/iv_progressBar/tv_debug_text，tv_debug_text 替换为 tv_last_update -->
<!-- ADR-14: 根布局从 LinearLayout 改为 ConstraintLayout -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cv_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:scrollbars="none">

    <!-- 域名分组标题（可选，分组模式下显示） -->
    <io.legado.app.ui.widget.text.AccentTextView
        android:id="@+id/tv_host_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:scrollbars="none"
        android:singleLine="true"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/iv_source_cover"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="host"
        tools:visibility="visible" />

    <!-- 左侧首字图标容器（参考书架封面 66x90dp，主题色背景+首字+启用状态点） -->
    <FrameLayout
        android:id="@+id/iv_source_cover"
        android:layout_width="66dp"
        android:layout_height="90dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_source_folder_cover"
        android:contentDescription="@string/rss_source"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_host_text">

        <!-- 首字（居中，白色加粗 28sp） -->
        <TextView
            android:id="@+id/tv_source_initial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:includeFontPadding="false"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:ignore="TextContrastCheck"
            tools:text="默" />

        <!-- 启用状态指示点（左上角） -->
        <View
            android:id="@+id/v_enabled_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_source_enabled_dot" />
    </FrameLayout>

    <!-- 订阅源名称（CheckBox，保留多选功能，16sp 对齐书架书名，ADR-18字号14sp→16sp） -->
    <io.legado.app.lib.theme.view.ThemeCheckBox
        android:id="@+id/cb_source"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="10dp"
        android:includeFontPadding="false"
        android:paddingLeft="2dp"
        android:paddingBottom="4dp"
        android:scrollbars="none"
        android:singleLine="true"
        android:textColor="@color/primaryText"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/tv_rss_source_url"
        app:layout_constraintLeft_toRightOf="@+id/iv_source_cover"
        app:layout_constraintRight_toLeftOf="@id/swt_enabled"
        app:layout_constraintTop_toBottomOf="@id/tv_host_text"
        tools:ignore="TouchTargetSizeCheck,RtlHardcoded,RtlSymmetry"
        tools:text="@string/rss_source" />

    <!-- 域名（13sp，drawableStart用已有图标，ADR-2复用ic_author） -->
    <TextView
        android:id="@+id/tv_rss_source_url"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_author"
        android:drawablePadding="4dp"
        android:drawableTint="@color/tv_text_summary"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingEnd="6dp"
        android:scrollbars="none"
        android:singleLine="true"
        android:textColor="@color/tv_text_summary"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@+id/tv_last_update"
        app:layout_constraintLeft_toLeftOf="@+id/cb_source"
        app:layout_constraintRight_toLeftOf="@id/swt_enabled"
        app:layout_constraintTop_toBottomOf="@+id/cb_source"
        tools:ignore="RtlSymmetry,TextContrastCheck,UseCompatTextViewDrawableXml"
        tools:text="sourceUrl" />

    <!-- 最后更新时间（13sp，drawableStart=ic_history，ADR-13：替代书源的tv_debug_text） -->
    <TextView
        android:id="@+id/tv_last_update"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:drawableStart="@drawable/ic_history"
        android:drawablePadding="4dp"
        android:drawableTint="@color/tv_text_summary"
        android:scrollbars="none"
        android:singleLine="true"
        android:textColor="@color/tv_text_summary"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/cb_source"
        app:layout_constraintRight_toLeftOf="@id/swt_enabled"
        app:layout_constraintTop_toBottomOf="@+id/tv_rss_source_url"
        tools:ignore="RtlSymmetry,TextContrastCheck,UseCompatTextViewDrawableXml"
        tools:text="2026-07-17 12:00" />

    <!-- 右侧操作按钮区 -->
    <io.legado.app.lib.theme.view.ThemeSwitch
        android:id="@+id/swt_enabled"
        android:name="@string/enable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="6dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/tv_last_update"
        app:layout_constraintRight_toLeftOf="@id/iv_edit"
        app:layout_constraintTop_toTopOf="@id/cb_source"
        tools:ignore="RtlHardcoded,RtlSymmetry,TouchTargetSizeCheck" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_edit"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/edit"
        android:padding="12dp"
        android:scrollbars="none"
        android:src="@drawable/ic_edit"
        android:tint="@color/primaryText"
        app:layout_constraintBottom_toTopOf="@id/tv_last_update"
        app:layout_constraintRight_toLeftOf="@id/iv_menu_more"
        app:layout_constraintTop_toTopOf="@id/cb_source" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_menu_more"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/more_menu"
        android:padding="12dp"
        android:scrollbars="none"
        android:src="@drawable/ic_more_vert"
        android:tint="@color/primaryText"
        app:layout_constraintBottom_toTopOf="@id/tv_last_update"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/cb_source"
        tools:ignore="RtlHardcoded" />

    <!-- 前景触摸反馈 -->
    <View
        android:id="@+id/vw_foreground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?android:attr/selectableItemBackground"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>

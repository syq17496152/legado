<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--
    阶段11.4 主题适配修复：
    - 根布局不设 background，让 BaseActivity.onCreateView 动态设置 backgroundColor（跟随主题）
    - TitleBar 加 app:title + app:themeMode="dark"（与书源 activity_book_info.xml 一致）
    -->
    <io.legado.app.ui.widget.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:themeMode="dark"
        app:title="@string/rss_article_info_title" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <io.legado.app.ui.widget.NoChildScrollNestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 封面图区域：无图时整体 gone，参考书源详情页 ArcView+CardView 设计 -->
                <RelativeLayout
                    android:id="@+id/rl_cover_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <!--
                    阶段11.4 主题适配：
                    - ArcView 删除 app:bgColor，在 Activity 中 setBgColor(backgroundColor) 动态跟随主题
                    - CardView 删除 cardBackgroundColor + 调整 cornerRadius=5dp/elevation=8dp，与书源 activity_book_info.xml 一致
                    - AppCompatImageView 删除 background，让透明继承 CardView 默认背景
                    -->
                    <io.legado.app.ui.widget.image.ArcView
                        android:id="@+id/arc_view"
                        android:layout_width="match_parent"
                        android:layout_height="78dp"
                        android:layout_marginTop="180dp"
                        app:arcDirectionTop="true"
                        app:arcHeight="36dp" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/iv_cover_c"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_centerHorizontal="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        app:cardCornerRadius="5dp"
                        app:cardElevation="8dp">

                        <!--
                        使用 AppCompatImageView 而非 CoverImageView：
                        - CoverImageView.onMeasure() 强制 4:3 宽高比 + load() 强制 centerCrop，
                          会导致横版图片在 4:3 容器中裁剪。
                        - AppCompatImageView 尊重 layout_height=match_parent(220dp) 与 scaleType=fitCenter，
                          固定 220dp 区域内：宽图上下留白完整显示、高图左右留白完整显示。
                        -->
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_cover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/img_cover"
                            android:scaleType="fitCenter"
                            android:src="@drawable/image_rss_article" />

                    </androidx.cardview.widget.CardView>

                </RelativeLayout>

                <!-- 标题与信息区 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="16dp"
                    android:paddingTop="12dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="8dp">

                    <!-- 文章标题 -->
                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primaryText"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="文章标题" />

                    <!-- 信息行容器 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">

                        <!-- 发布时间 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            tools:ignore="UseCompoundDrawables">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@string/rss_article_info_pub_date"
                                android:paddingRight="6dp"
                                android:src="@drawable/ic_book_last"
                                app:tint="@color/tv_text_summary"
                                tools:ignore="RtlHardcoded,RtlSymmetry" />

                            <TextView
                                android:id="@+id/tv_pub_date"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:textColor="@color/tv_text_summary"
                                android:textSize="13sp"
                                tools:ignore="NestedWeights,RtlHardcoded,RtlSymmetry"
                                tools:text="2026-07-20" />

                        </LinearLayout>

                        <!-- 文章类型 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            tools:ignore="UseCompoundDrawables">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@string/rss_article_type"
                                android:paddingRight="6dp"
                                android:src="@drawable/ic_web_outline"
                                app:tint="@color/tv_text_summary"
                                tools:ignore="RtlHardcoded,RtlSymmetry" />

                            <TextView
                                android:id="@+id/tv_type"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:textColor="@color/tv_text_summary"
                                android:textSize="13sp"
                                tools:ignore="NestedWeights,RtlHardcoded,RtlSymmetry"
                                tools:text="视频" />

                        </LinearLayout>

                        <!-- 来源数量 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            tools:ignore="UseCompoundDrawables">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@string/rss_source_count"
                                android:paddingRight="6dp"
                                android:src="@drawable/ic_groups"
                                app:tint="@color/tv_text_summary"
                                tools:ignore="RtlHardcoded,RtlSymmetry" />

                            <TextView
                                android:id="@+id/tv_source_count"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:textColor="@color/tv_text_summary"
                                android:textSize="13sp"
                                tools:ignore="NestedWeights,RtlHardcoded,RtlSymmetry"
                                tools:text="共 3 个来源" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/divider" />

                    <!-- 内容简介 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/book_intro"
                        android:textColor="@color/secondaryText"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <io.legado.app.ui.widget.text.ScrollTextView
                        android:id="@+id/tv_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/primaryText"
                        android:textSize="15sp"
                        tools:text="内容简介" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/divider" />

                    <!-- 全部来源 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/rss_all_sources"
                        android:textColor="@color/secondaryText"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_source_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

            </LinearLayout>

        </io.legado.app.ui.widget.NoChildScrollNestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 底部操作栏：参考书源详情页 fl_action 设计
         阶段11.4 主题适配：删除 android:background="@color/background_menu"，
         让底部栏透明继承根背景（ BaseActivity 动态设置的 backgroundColor，跟随应用内主题色切换）。
         分隔线也用 transparent 替代静态 bg_divider_line，避免暗色模式下出现不一致色块。 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/bg_divider_line" />

    <LinearLayout
        android:id="@+id/ll_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_cancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/cancel"
            android:textColor="@color/primaryText"
            android:textSize="15sp" />

        <io.legado.app.ui.widget.text.AccentBgTextView
            android:id="@+id/tv_read"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/reading"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>

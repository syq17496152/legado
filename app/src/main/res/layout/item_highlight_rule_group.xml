<?xml version="1.0" encoding="utf-8"?>
<!-- F-P1-2 高亮规则分组列表项（借鉴蛋蛋Max,适配当前项目） -->
<!-- 适配说明：
     1. shape_highlight_rule_card → shape_card_view
     2. shape_highlight_rule_action → ?attr/selectableItemBackground
     3. tv_edit/tv_delete 用 MaterialButton TextButton 替代 TextView+drawable
     4. item_root 用 foreground=selectableItemBackground 实现点击反馈 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="4dp"
    android:background="@drawable/shape_card_view"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primaryText"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/secondaryText"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/tv_edit"
        style="?attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:paddingHorizontal="8dp"
        android:text="@string/edit"
        android:textColor="@color/primaryText"
        android:textSize="11sp" />

    <Button
        android:id="@+id/tv_more"
        style="?attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:minWidth="0dp"
        android:paddingHorizontal="8dp"
        android:text="@string/more"
        android:textColor="@color/primaryText"
        android:textSize="11sp" />

</LinearLayout>
